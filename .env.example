# Copy to .env and adjust. All values are optional; the defaults run locally
# with SQLite and no external services.

# DATABASE_URL=postgresql+psycopg://cert_user:cert_pass@localhost:5432/certificates
STORAGE_DIR=./storage/certificates
MAX_RECIPIENTS_PER_JOB=1000
MAX_WORKERS=4

# Empty disables API-key auth. Set a strong value in production.
API_KEY=

# Expose /docs and /openapi.json (disable in production if desired).
ENABLE_DOCS=true

# Comma-separated list, or * to allow any origin.
CORS_ORIGINS=*

# Background jobs (Celery). In the test suite these run inline via
# CELERY_TASK_ALWAYS_EAGER=true, so no broker is needed.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false

# docker-compose services
POSTGRES_USER=cert_user
POSTGRES_PASSWORD=cert_pass
POSTGRES_DB=certificates
APP_PORT=8000
WEB_CONCURRENCY=2
